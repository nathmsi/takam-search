{
  "name": "@takam/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The web app of Takam Search (React, Vite): search the instructions of chapter 1, read one with what changed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "pnpm --filter @takam/server build && pnpm build && playwright test",
    "test:e2e:ui": "pnpm --filter @takam/server build && pnpm build && playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@takam/contracts": "workspace:*",
    "@tanstack/react-query": "5.90.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
