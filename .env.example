# The environment variables of the project. None is needed to run it; GEMINI_API_KEY (below) is the only secret.
# Set them in the shell (for example `PORT=4000 pnpm dev`), or in `apps/server/.env` (git ignores it): `pnpm dev` and
# `pnpm data:embed` read that file (Node's --env-file), the built server (`node dist/main.js`) and the tests do not.

# Port of the API.
PORT=3100

# Origins allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Where the database lives (apps/server). Default: apps/server/.pgdata. `memory://` keeps it in memory (the tests do).
# DATABASE_DIR=

# The web app (apps/web) reads this at build time. Empty = same origin (the dev and preview servers proxy /v1 to the API).
# VITE_API_URL=

# The AI key of the search by meaning (experiment). Without it that search answers 503 and everything else works.
# A SECRET: put it in `apps/server/.env` (ignored by git), in the shell, or in Vercel; never in a file that git tracks.
# `pnpm data:embed` needs it too.
# GEMINI_API_KEY=
# AI_PROVIDER=gemini

# The API of the Takam site (the file of a document, and `pnpm data:refresh`). Default: https://takam.mof.gov.il/api
# TAKAM_API_URL=
